{
	"name": "contentful-svelte-blog",
	"compatibility_date": "2025-01-10",
	"main": ".svelte-kit/cloudflare/_worker.js",

	// Workers with Assets configuration
	"assets": {
		"directory": ".svelte-kit/cloudflare/assets",
		"binding": "ASSETS"
	},

	// Environment variables (non-secret)
	"vars": {
		"CONTENTFUL_SPACE_ID": "your_space_id_here",
		"CONTENTFUL_ENVIRONMENT": "master"
	},

	// Secret variables should be set via:
	// npx wrangler secret put CONTENTFUL_ACCESS_TOKEN
	// npx wrangler secret put CONTENTFUL_PREVIEW_ACCESS_TOKEN
	// npx wrangler secret put CONTENTFUL_MANAGEMENT_TOKEN

	// Node.js compatibility for SvelteKit
	"compatibility_flags": ["nodejs_compat"],

	// Optional: Configure custom domains, routes, etc.
	// "routes": [
	// 	{
	// 		"pattern": "/*",
	// 		"custom_domain": true
	// 	}
	// ],

	// Observability (optional)
	"observability": {
		"enabled": true
	}
}
