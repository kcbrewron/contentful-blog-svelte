{
	"name": "blog",
	"compatibility_date": "2025-01-10",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"workers_dev": false,
	"preview_urls": true,
	// Workers with Assets configuration
	"assets": {
		"directory": ".svelte-kit/cloudflare/assets",
		"binding": "ASSETS"
	},
	// Environment variables (non-secret)
	"vars": {
		"CONTENTFUL_SPACE_ID": "2tyl7ps8aucz",
		"CONTENTFUL_ENVIRONMENT": "master",
		// Turnstile site key (get from Cloudflare dashboard → Turnstile)
		"ADMIN_EMAIL": "ron@ronnelson.dev"
	},
	// D1 database for email subscribers
	// Run: npx wrangler d1 create blog-subscribers
	// Then replace database_id below with the returned ID
	"d1_databases": [
		{
			"binding": "SUBSCRIBERS_DB",
			"database_name": "blog-subscribers",
			"database_id": "8aca3c3b-031b-4646-856a-56d601c2f062"
		}
	],
	// Email sending via Cloudflare Email Routing
	// Requires Email Routing enabled for ronnelson.dev in Cloudflare dashboard
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	// Secret variables should be set via:
	// npx wrangler secret put CONTENTFUL_ACCESS_TOKEN
	// npx wrangler secret put CONTENTFUL_PREVIEW_ACCESS_TOKEN
	// npx wrangler secret put CONTENTFUL_MANAGEMENT_TOKEN
	// npx wrangler secret put TURNSTILE_SECRET_KEY
	// Node.js compatibility for SvelteKit
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Optional: Configure custom domains, routes, etc.
	// "routes": [
	// 	{
	// 		"pattern": "/*",
	// 		"custom_domain": true
	// 	}
	// ],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	}
}