{
  "name": "contentful-svelte-blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "docs": "jsdoc -c jsdoc.config.json",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:dry-run": "npm run build && npx wrangler deploy --dry-run",
    "wrangler:tail": "npx wrangler tail",
    "wrangler:dev": "npm run build && npx wrangler dev",
    "contentful:publish-model": "node scripts/publish-content-model.js",
    "contentful:list-types": "node scripts/list-content-types.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "contentful-management": "^12.15.0",
    "dotenv": "^17.4.2",
    "jsdoc": "^4.0.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "type": "module",
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^17.2.3",
    "contentful": "^11.12.9",
    "mimetext": "^3.0.28",
    "prismjs": "^1.30.0"
  },
  "packageManager": "yarn@4.10.3"
}
