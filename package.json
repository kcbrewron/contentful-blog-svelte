{
  "name": "contentful-svelte-blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "docs": "jsdoc -c jsdoc.config.json",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:dry-run": "npm run build && npx wrangler deploy --dry-run",
    "wrangler:tail": "npx wrangler tail",
    "wrangler:dev": "npm run build && npx wrangler dev",
    "contentful:publish-model": "node scripts/publish-content-model.js",
    "contentful:list-types": "node scripts/list-content-types.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "autoprefixer": "^10.4.14",
    "contentful-management": "^11.60.4",
    "dotenv": "^17.2.3",
    "jsdoc": "^4.0.2",
    "postcss": "^8.4.24",
    "svelte": "^5.53.5",
    "svelte-check": "^3.4.3",
    "tailwindcss": "^3.3.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "wrangler": "^4.42.0"
  },
  "type": "module",
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^17.1.5",
    "contentful": "^11.8.4",
    "mimetext": "^3.0.28",
    "prismjs": "^1.30.0"
  },
  "packageManager": "yarn@4.10.3"
}
