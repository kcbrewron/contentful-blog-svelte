{
  "name": "contentful-svelte-blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "docs": "jsdoc -c jsdoc.config.json",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:dry-run": "npm run build && npx wrangler deploy --dry-run",
    "wrangler:tail": "npx wrangler tail",
    "wrangler:dev": "npm run build && npx wrangler dev",
    "contentful:publish-model": "node scripts/publish-content-model.js",
    "contentful:list-types": "node scripts/list-content-types.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.53.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "contentful-management": "^11.74.0",
    "dotenv": "^17.3.1",
    "jsdoc": "^4.0.5",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.71.0"
  },
  "type": "module",
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^17.1.6",
    "contentful": "^11.10.5",
    "mimetext": "^3.0.28",
    "prismjs": "^1.30.0"
  },
  "packageManager": "yarn@4.10.3"
}
