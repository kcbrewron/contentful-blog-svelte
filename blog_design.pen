        {
          "type": "frame",
          "id": "Siumw",
          "name": "Article Body",
          "width": "fill_container",
          "fill": "#0A0A0F",
          "gap": 48,
          "padding": [
            64,
            80
          ],
          "children": [
            {
              "type": "frame",
              "id": "nHC3h",
              "name": "Main Content",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 40,
              "children": [
                {
                  "type": "frame",
                  "id": "X7vaU",
                  "name": "intro",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "OMgO8",
                      "name": "introLead",
                      "fill": "#A1A1AA",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Cloudflare Workers is a serverless platform that allows developers to run JavaScript at the edge of the network, closest to users. This results in faster, more secure, and more reliable applications.",
                      "lineHeight": 1.75,
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "UocGh",
                      "name": "introBody",
                      "fill": "#71717A",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "In this post, we'll dive deep into the Cloudflare Workers platform, exploring its runtime model, edge execution model, performance benchmarks, and security model. By the end, you'll have a solid foundation for building production-grade APIs that run at the edge.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "vJ6S4",
                  "name": "section1",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "JeuUH",
                      "name": "s1Heading",
                      "fill": "#FFFFFF",
                      "content": "Runtime Model",
                      "fontFamily": "Outfit",
                      "fontSize": 30,
                      "fontWeight": "700",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "Kn8tR",
                      "name": "s1Body",
                      "fill": "#71717A",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The Cloudflare Workers runtime is based on a lightweight, JavaScript V8 isolate environment. Unlike traditional serverless platforms that spin up containers per request, Workers uses V8 isolates — starting in under 5ms with far less memory overhead. This is how cold starts are effectively eliminated.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "cX7BM",
                  "name": "blockquote",
                  "width": "fill_container",
                  "fill": "#0D0D17",
                  "cornerRadius": 8,
                  "gap": 20,
                  "padding": [
                    24,
                    28
                  ],
                  "children": [
                    {
                      "type": "rectangle",
                      "cornerRadius": 2,
                      "id": "XASlM",
                      "name": "bqAccent",
                      "fill": "#6366F1",
                      "width": 3,
                      "height": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "hVtc5",
                      "name": "bqText",
                      "fill": "#A1A1AA",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"The edge isn't just about latency — it's about bringing logic closer to data, users, and events. Workers fundamentally changes where computation happens.\"",
                      "lineHeight": 1.6,
                      "fontFamily": "Outfit",
                      "fontSize": 18,
                      "fontWeight": "600",
                      "letterSpacing": -0.3
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "FVHBP",
                  "name": "section2",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "iRXbG",
                      "name": "s2Heading",
                      "fill": "#FFFFFF",
                      "content": "Simple Worker Example",
                      "fontFamily": "Outfit",
                      "fontSize": 30,
                      "fontWeight": "700",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "6JTAv",
                      "name": "s2Body",
                      "fill": "#71717A",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Here's the minimal structure of a Cloudflare Worker. The fetch handler receives every incoming HTTP request and returns a Response object. The env parameter gives you access to bindings like KV, Durable Objects, and secrets.",
                      "lineHeight": 1.8,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "PEqJA",
                  "name": "codeBlock",
                  "width": "fill_container",
                  "fill": "#06060C",
                  "cornerRadius": 10,
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#1A1A2E"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 24,
                  "children": [
                    {
                      "type": "frame",
                      "id": "Vouj9",
                      "name": "codeLabel",
                      "width": "fill_container",
                      "justifyContent": "space_between",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "JV4Q1",
                          "name": "codeLang",
                          "fill": "#6366F1",
                          "content": "JAVASCRIPT",
                          "fontFamily": "Inter",
                          "fontSize": 11,
                          "fontWeight": "600",
                          "letterSpacing": 2
                        },
                        {
                          "type": "frame",
                          "id": "j5wGR",
                          "name": "codeCopy",
                          "gap": 6,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon_font",
                              "id": "LQNMo",
                              "name": "codeCopyIcon",
                              "width": 14,
                              "height": 14,
                              "iconFontName": "copy",
                              "iconFontFamily": "lucide",
                              "fill": "#71717A"
                            },
                            {
                              "type": "text",
                              "id": "TOSwk",
                              "name": "codeCopyText",
                              "fill": "#71717A",
                              "content": "Copy",
                              "fontFamily": "Inter",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "rectangle",
                      "id": "SrGh7",
                      "name": "codeDivider",
                      "fill": "#1A1A2E",
                      "width": "fill_container",
                      "height": 1
                    },
                    {
                      "type": "text",
                      "id": "D3rAx",
                      "name": "codeContent",
                      "fill": "#A1A1AA",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "export default {\n  async fetch(request, env, ctx) {\n    const url = new URL(request.url)\n\n    if (url.pathname === '/api/data') {\n      const data = await env.KV.get('key')\n      return Response.json({ data })\n    }\n\n    return new Response('Hello World!')\n  }\n}",
                      "lineHeight": 1.7,
                      "fontFamily": "Space Mono",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
